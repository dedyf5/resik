Table tenant_member_resource_scopes {
  tenant_member_id bigint(20) [not null]
  resource_code varchar(75) [not null]
  scope_by varchar(45) [not null]
  scope_ref varchar(100) [not null]

  Indexes {
    (tenant_member_id, resource_code, scope_by, scope_ref) [pk]
    (tenant_member_id, resource_code)
  }

  Records {
    2, "merchant.settings", "merchant", "merchant_uuid_v7_10"
    2, "transaction", "merchant", "merchant_uuid_v7_10"
    3, "transaction", "outlet", "outlet_uuid_v7_11"
    3, "transaction", "outlet", "outlet_uuid_v7_12"
  }

  Note: '''
  Defines data visibility restrictions for a tenant member.

  Permissions define what actions a member can perform.
  Resource scopes define which data instances are accessible.

  If a resource has no scope restriction,
  the member can access all instances of that resource
  allowed by their permissions.

  Examples:
  - transaction + merchant + merchant_uuid_1
  - transaction + outlet + outlet_uuid_10
  - report + region + region_jakarta
  '''
}

Ref: users.created_by_id > users.id
Ref: users.updated_by_id > users.id

Ref: tenants.created_by_id > users.id
Ref: tenants.updated_by_id > users.id

Ref: tenant_members.user_id > users.id
Ref: tenant_members.tenant_id > tenants.id
Ref: tenant_members.created_by_id > users.id
Ref: tenant_members.updated_by_id > users.id

Ref: permissions.created_by_id > users.id
Ref: permissions.updated_by_id > users.id

Ref: tenant_member_permissions.tenant_member_id > tenant_members.id
Ref: tenant_member_permissions.permission_id > permissions.id

Ref: tenant_member_resource_scopes.tenant_member_id > tenant_members.id

tablegroup identity_service {
  users
  tenants
  tenant_members
  permissions
  tenant_member_permissions
  tenant_member_resource_scopes
}
